# v8 joined-page-only notifications need no server notification keys.
# VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT and PUSH_STORE_PATH
# from v7 are ignored by this release. Do not add secrets to this file.
# v9 owner console: generate locally and set only in the TempChat Render service.
# ADMIN_KEY must be a generated 32+ character base64url key, never a reused push key.
ADMIN_KEY=
